%% TLC file to automatically create the wrapper for IEC 61400-27 DLL 
%% creation.
%%
%% This file is used by Simulink Coder (TLC language) to generate a C 
%% wrapper around a compiled Simulink model so it can be exported as an 
%% IEC 61400-27 DLL.
%%
%% Creator: Gregor Becker
%% Email: gregor.becker@fau.de
%% Creator: Dominik Frauenknecht
%% Email: dominik.frauenknecht@fau.de
%% Last modified: 18.02.2026
%%


%implements IEC61400_27_wrapper_builder "C"

%%=============================================================================
%% Function: BlockInstanceSetup
%% Purpose:
%%   Marks the block as expression compliant (required for code generation).
%%=============================================================================
%function BlockInstanceSetup(block, system) void
  %<LibBlockSetIsExpressionCompliant(block)>
%endfunction


%%=============================================================================
%% Function: FcnStructInputOutput
%% Purpose:
%%   Main TLC function that generates the C wrapper file for the DLL.
%%   - Creates source file
%%   - Extracts model I/O and parameters
%%   - Generates C structures and exported API functions
%%=============================================================================
%function FcnStructInputOutput() Output
    
  %% Create empty C source file
  %assign fileh = LibCreateSourceFile("Source", "Custom", "IEC61400_27_DLL")
  
  %% Extract model interface information from compiled Simulink model
  %assign numExtInputs  = CompiledModel.ExternalInputs.NumExternalInputs
  %assign numExtOutputs = CompiledModel.ExternalOutputs.NumExternalOutputs
  %assign numParameters = SIZE(CompiledModel.ModelParameters.GlobalParamsList)[1]

  %% Store metadata in a record
  %createrecord CodeExtIO {     \
    NumInputs  %<numExtInputs>  \
    NumOutputs %<numExtOutputs> \
    NumParameters %<numParameters> \
  }

  %%===========================================================================
  %% Write C header includes and macro definitions
  %%===========================================================================
  %openfile tmpBuf
    /* %<CompiledModel.ModelParameters> */
    /*
     * Copyright 1994-2026 The MathWorks, Inc.
     *
     * File    : IEC61400_27_DLL.c
     *
     * Abstract: Wrapper for IEC 61400-27 DLL creation.
     *
     *
     * Compiler specified defines:
     *	RT              - Required.
     *  MODEL=modelname - Required.
     *	NUMST=#         - Required. Number of sample times.
     *	NCSTATES=#      - Required. Number of continuous states.
     *  TID01EQ=1 or 0  - Optional. Only define to 1 if sample time task
     *                    id's 0 and 1 have equal rates.
     *  MULTITASKING    - Optional. (use MT for a synonym).
     *	SAVEFILE        - Optional (non-quoted) name of .mat file to create.
     *			          Default is <MODEL>.mat
     */

    /* Standard C libraries */
    #include <float.h>
    #include <stdio.h>
    #include <stdlib.h>
    #include <string.h>
    #include <windows.h>
    
    /* IEC 61400-27 interface */
    #include "ext_simenv_capi.h"
    
    /* Simulink runtime headers. */
    #include "rtwtypes.h"
    #include "rtmodel.h"
    #include "rt_sim.h"
    #include "rt_logging.h"
    #include "rtw_modelmap.h"
    #include "ext_work.h"
    
    /* Boolean + return macros */
    #ifndef TRUE
    #define FALSE (0)
    #define TRUE  (1)
    #endif
    
    /* Make sure required Attributes are set */
    #ifndef RT
    # error "must define RT"
    #endif
    
    #ifndef MODEL
    # error "must define MODEL"
    #endif
    
    #ifndef NUMST
    # error "must define number of sample times, NUMST"
    #endif
    
    #ifndef NCSTATES
    # error "must define NCSTATES"
    #endif
    
    #define RUN_FOREVER -1.0
    
    /* 
       Macro mapping Simulink naming conventions 
       suffix: U=Inport, Y=Outport, X=Parameter, DW=Discrete Work
    */
    #define EXPAND_CONCAT(name1,name2) name1 ## name2
    #define CONCAT(name1,name2) EXPAND_CONCAT(name1,name2)
    #define RT_MODEL            CONCAT(MODEL,_rtModel)

    #define EXPAND_CONCAT3(name1,name2,name3) name1 ## _ ## name2 ## . ## name3
    #define CONCAT3(name1,name2,name3) EXPAND_CONCAT3(name1,name2,name3)
    #define SIG_MODEL(suffix,name)     CONCAT3(MODEL,suffix,name)

    /* External Simulink model functions */

    /* Returns a pointer to the real-time model structure */
    extern RT_MODEL *MODEL(void);

    /* Initializes model sizes (e.g., number of states, inputs, outputs) */
    extern void MdlInitializeSizes(void);

    /* Initializes sample times for the model */
    extern void MdlInitializeSampleTimes(void);

    /* Called once at the start of the simulation */
    extern void MdlStart(void);

    /* Computes model outputs at each time step */
    extern void MdlOutputs(int_T tid);

    /* Updates model states at each time step */
    extern void MdlUpdate(int_T tid);

    /* Cleans up resources at the end of the simulation */
    extern void MdlTerminate(void);


    /* ===== Continuous State Handling ===== */

    /* If the model has continuous states */
    #if NCSTATES > 0
    
        /* Allocates and initializes ODE solver integration data */
        extern void rt_ODECreateIntegrationData(RTWSolverInfo *si);
    
        /* Updates continuous states using the ODE solver */
        extern void rt_ODEUpdateContinuousStates(RTWSolverInfo *si);
    
        /* Macro to initialize integration data using solver info from model */
        #define rt_CreateIntegrationData(S) \
            rt_ODECreateIntegrationData(rtmGetRTWSolverInfo(S));
    
        /* Macro to update continuous states using solver info from model */
        #define rt_UpdateContinuousStates(S) \
            rt_ODEUpdateContinuousStates(rtmGetRTWSolverInfo(S));

    #else

        /* If there are NO continuous states (purely discrete model) */
    
        /* Set solver type to fixed-step discrete */
        #define rt_CreateIntegrationData(S)  \
            rtsiSetSolverName(rtmGetRTWSolverInfo(S),"FixedStepDiscrete");
    
        /* No continuous states to update → do nothing */
        #define rt_UpdateContinuousStates(S) /* Do Nothing */

    #endif

%closefile tmpBuf
%<LibSetSourceFileSection(fileh, "Includes", tmpBuf)>  

%with CompiledModel
  %%===========================================================================
  %% Generate static input signal description array
  %%===========================================================================
  %openfile tmpBuf
  const StaticESEInputSignal static_inputs[] = {
  %closefile tmpBuf
  %<LibSetSourceFileSection(fileh, "Includes", tmpBuf)>  

  %foreach InputID = ExternalInputs.NumExternalInputs
    %% get the input Metadata
    %assign extInp = ExternalInputs.ExternalInput[InputID]
    %assign dataType = SLibGetRecordDataTypeName(extInp, "")
    %assign sigName = extInp.Identifier
    %assign sigWidth = LibGetRecordWidth(extInp)
    
    %% Append entry to C array
    %openfile tmpBuf  
      {"%<sigName>", "" ,  %<sigWidth>},
    %closefile tmpBuf
    %<LibSetSourceFileSection(fileh, "Includes", tmpBuf)>  
  %endforeach

  %% Close input array
  %openfile tmpBuf
  };
  %closefile tmpBuf
  %<LibSetSourceFileSection(fileh, "Includes", tmpBuf)>  

  %%===========================================================================
  %% Generate static output signal description array
  %%===========================================================================
  %openfile tmpBuf
  const StaticESEOutputSignal static_outputs[] = {
  %closefile tmpBuf
  %<LibSetSourceFileSection(fileh, "Defines", tmpBuf)>  
  
  %% loop over the number of outputs
  %foreach OutputID = ExternalOutputs.NumExternalOutputs
    %% get the output Metadata
    %assign extOut = ExternalOutputs.ExternalOutput[OutputID]
    %assign dataType = SLibGetRecordDataTypeName(extOut, "")
    %assign sigName = extOut.Identifier
    %assign sigWidth = LibGetRecordWidth(extOut)
       
    %% Append entry to C array
    %openfile tmpBuf  
    { "%<sigName>", "", %<sigWidth> },
    %closefile tmpBuf
    %<LibSetSourceFileSection(fileh, "Defines", tmpBuf)>  
  %endforeach
  
  %% Close output array
  %openfile tmpBuf
  };
  %closefile tmpBuf
  %<LibSetSourceFileSection(fileh, "Defines", tmpBuf)>
  
  %%===========================================================================
  %% Generate static parameter description array
  %%===========================================================================
  %openfile tmpBuf
  const StaticESEParameter static_parameters[] = {
  %closefile tmpBuf
  %<LibSetSourceFileSection(fileh, "Defines", tmpBuf)>

  %foreach ParamID = %<numParameters>
    %% get the parameter Metadata
    %assign sigName = CompiledModel.ModelParameters.GlobalParamsList[ParamID]
    
    %% Append entry to C array
    %openfile tmpBuf  
    { "%<sigName>", "%<sigName>", "n/a", 0., -1e6, 1e6 },
    %closefile tmpBuf
    %<LibSetSourceFileSection(fileh, "Defines", tmpBuf)>  
  %endforeach
    
  %% Close parameter array
  %openfile tmpBuf 
    };
  %closefile tmpBuf
  %<LibSetSourceFileSection(fileh, "Defines", tmpBuf)>
    
  %%===========================================================================
  %% Generate model info struct (IEC interface description)
  %%===========================================================================
  %openfile tmpBuf 
    StaticExtSimEnvCapi static_model_info = {
	    {0, 8, 1, 5},	                                                   // const uint8_T APIRelease[4]: Release number of the API used during code generation
	    "IEC DLL of a Matlab Simulink Model",	                           // const char_T * const ModelName: Model name
	    "R01-V01",			                                               // const char_T * const ModelVersion: Model version
	    "IEC DLL of a Matlab Simulink Model",	                           // const char_T * const ModelDescription: Model description
	    "",				                                                   // const char_T * const VersionControlInfo: Version control information
	    "",	                                                               // const char_T * const GeneralInformation: General info 
	    "2026-02-18",	                                                   // const char_T * const ModelCreated: Model created on
	    "G. Becker",	                                                   // const char_T * const ModelCreator: Model created by
	    "2026-02-18",	                                                   // const char_T * const ModelLastModifiedDate:  Model last modified on
	    "G. Becker",	                                                   // const char_T * const ModelLastModifiedBy: Model last modified by
	    "",	                                                               // const char_T * const ModelModifiedComment: Model modified comment
	    "",				                                                   // const char_T * const ModelModifiedHistory: Model modified history
	    "2026-02-18",                                                      // const char_T * const CodeGeneratedOn: Code generated on
	    "",				                                                   // const char_T * const IncludedSolver: Solver name (can be empty)
	    0.00005,			                                               // const real64_T FixedStepBaseSampleTime: Base sample time hardcoded sample time size
	    sizeof(static_inputs)/sizeof(static_inputs[0]),	                   // const int32_T NumInputPorts: Number of inputs
	    &static_inputs[0],	                                               // const StaticESEInputSignal * const InputPortsInfo: Pointer to input signal description array
	    sizeof(static_outputs)/sizeof(static_inputs[0]),	               // const int32_T NumOutputPorts: Number of outputs
	    &static_outputs[0],	                                               // const StaticESEOutputSignal * const OutputPortsInfo: Pointer to output signal description array
	    sizeof(static_parameters)/sizeof(static_parameters[0]),	           // const int32_T NumParameters: Number of parameters
	    &static_parameters[0],	                                           // const StaticESEParameter * const ParametersInfo: Pointer to parameter description array
	    0,                                                                 // const int32_T NumContStates: Number of continuous states
	    0,	                                                               // const int32_T SizeofMiscStates: Size of work variables / misc states
	    {0, 0, 0, 0},	                                                   // const uint32_T ModelChecksum[4]:  Model checksum (user defined)
	    NULL,			                                                   // const char_T *LastErrorMessage: Error string pointer
	    3,				                                                   // const uint8_T EMT_RMS_Mode: Mode: EMT = 1, RMS = 2, EMT & RMS = 3, otherwise: 0
	    0,				                                                   // const uint8_T LoadflowFlag: Model contains a loadflow function: 0 = no, 1 = yes
	    0				                                                   // ESEExtension Extension: Provided for extensions
    };
  %closefile tmpBuf
  %<LibSetSourceFileSection(fileh, "Defines", tmpBuf)>
    
  %%===========================================================================
  %% DLL API functions
  %%===========================================================================
  %openfile tmpBuf
    static RT_MODEL *S;
    
    /* Returns static model information */
    __declspec(dllexport) const StaticExtSimEnvCapi* __cdecl Model_GetInfo(void)
    {
	    return &static_model_info;
    }

    /* Creates a runtime instance of the model */
    __declspec(dllexport) InstanceExtSimEnvCapi* __cdecl Model_Instance(void)
    {
        /* integers used for memory allocation */
	    uint8_T i, w;
    
        /* initilization of the simulink model */
        S = MODEL();
	    
        /* declaration of the inner-model cache */
        InstanceExtSimEnvCapi * pInstanceCapi;
        /* memory allocation for the inner-model cache */
	    pInstanceCapi = (InstanceExtSimEnvCapi *)malloc(sizeof(InstanceExtSimEnvCapi));
        /* safety check if allocation worked */
	    if (pInstanceCapi == NULL) { return NULL; }
    
	    /* Memory allocation for model input ports */
	    w = 0;
	    for (i = 0; i < static_model_info.NumInputPorts; i++) {
		    w = w + (&static_model_info)->InputPortsInfo[i].Width;
	    }
	    pInstanceCapi->ExtU_DISCON_Empty_T = (real64_T *)malloc(w*sizeof(real64_T));
		    
	    /* Memory allocation for model output ports */
	    w = 0;
	    for (i = 0; i < static_model_info.NumOutputPorts; i++) {
		    w = w + (&static_model_info)->OutputPortsInfo[i].Width;
	    }
	    pInstanceCapi->ExtY_DISCON_Empty_T = (real64_T *)malloc(w*sizeof(real64_T));
	    
        /* Memory allocation for model parameter */   
	    pInstanceCapi->P_DISCON_Empty_T = (real64_T *)malloc(
		    static_model_info.NumParameters*sizeof(real64_T));
	    
        /* Unused attributes of the IEC 61400 DLL wrapper */
        pInstanceCapi->ContinuousStates = NULL;
  	    pInstanceCapi->StateDerivatives = NULL;
   	    pInstanceCapi->MiscStates = NULL;
   	    pInstanceCapi->LastGeneralMessage = NULL;
   	    pInstanceCapi->VerboseLevel = 0;
   	    pInstanceCapi->Extension.UserVoidPtr = NULL;
    
	    return pInstanceCapi;
    }
    
    /* Unused DLL Wrapper methods */
    __declspec(dllexport) const char* __cdecl Model_CheckParameters(InstanceExtSimEnvCapi *pInstanceCapi){ return NULL; }
    __declspec(dllexport) const char* __cdecl Model_Loadflow(InstanceExtSimEnvCapi *pInstanceCapi){ return NULL; }
    __declspec(dllexport) const char* __cdecl Model_Derivatives(InstanceExtSimEnvCapi *pInstanceCapi){ return NULL; }
    
    
    /* Model_Terminate */
    __declspec(dllexport) const char* __cdecl Model_Terminate(InstanceExtSimEnvCapi *pInstanceCapi)
    {	
	    /* free ExternalInputs */
	    free(pInstanceCapi->ExtU_DISCON_Empty_T);
	    pInstanceCapi->ExtU_DISCON_Empty_T = NULL;
    
	    /* free ExternalOutputs */
	    free(pInstanceCapi->ExtY_DISCON_Empty_T);
	    pInstanceCapi->ExtY_DISCON_Empty_T = NULL;
    
	    /* free Parameters */
	    free(pInstanceCapi->P_DISCON_Empty_T);
	    pInstanceCapi->P_DISCON_Empty_T = NULL;
    
	    /* free ContinuousStates */
	    free(pInstanceCapi->ContinuousStates);
	    pInstanceCapi->ContinuousStates = NULL;
    
	    /* free StateDerivatives */
	    free(pInstanceCapi->StateDerivatives);
	    pInstanceCapi->StateDerivatives = NULL;
    
	    /* free MiscStates */
	    free(pInstanceCapi->MiscStates);
	    pInstanceCapi->MiscStates = NULL;
    
	    /* free model instance */
	    free(pInstanceCapi);
	    pInstanceCapi = NULL;
    
	    return NULL;
    }
  %closefile tmpBuf
  %<LibSetSourceFileSection(fileh, "Defines", tmpBuf)>

  %%===========================================================================
  %% DLL API function for model initialization
  %%===========================================================================
  %openfile tmpBuf
    __declspec(dllexport) const char* __cdecl Model_Initialize(InstanceExtSimEnvCapi *pInstanceCapi)
    {
	    //---------------------------------------------------------------------
        // Initialize external output signals to a defined default (0.0)
        // This ensures deterministic startup behavior of the model outputs
        //---------------------------------------------------------------------
        for (int i=0; i<%<numExtOutputs>; i++)
        {
	        pInstanceCapi->ExtY_DISCON_Empty_T[i] = 0.;
        }
  %closefile tmpBuf
  %<LibSetSourceFileSection(fileh, "Defines", tmpBuf)>
  
  %%---------------------------------------------------------------------------
  %% Map external parameters (from C-API) into Simulink model parameters
  %%  
  %% numParameters = number of externally tunable parameters
  %% GlobalParamsList = list of parameter names exposed to the environment
  %%---------------------------------------------------------------------------
  %foreach GlobParamID = %<numParameters>

    %% Retrieve parameter metadata from compiled model
    %assign model_param = CompiledModel.ModelParameters
    %assign sigName = model_param.GlobalParamsList[GlobParamID]
      
      %%-----------------------------------------------------------------------
      %% Direct parameter mapping:
      %% Match external parameter names with internal model parameters
      %% and assign their values
      %%-----------------------------------------------------------------------
      %foreach ParamId = model_param.NumParameters

        %% Internal Simulink parameter identifier 
        %assign P_scope_name = model_param.Parameter[ParamId].Identifier
            
        %% If external parameter matches internal parameter → assign value
        %if P_scope_name == sigName
          %% map external parameter to model parameter 
          %openfile tmpBuf
            SIG_MODEL(P, %<P_scope_name>) = pInstanceCapi->P_DISCON_Empty_T[%<GlobParamID>];
          %closefile tmpBuf
          %<LibSetSourceFileSection(fileh, "Defines", tmpBuf)>
        %endif
      %endforeach
      
      %%-----------------------------------------------------------------------
      %% Indirect parameter mapping:
      %% Handle parameters embedded inside expressions (e.g. polynomials)
      %%
      %% Example:
      %%   Expression: [1 T S]
      %%   External parameter "T" must be mapped to correct index
      %%-----------------------------------------------------------------------
      %foreach ParamId = model_param.NumParameters

        %% Access block hierarchy for resolving parameter locations
        %assign BLKHR = CompiledModel.BlockHierarchyMap
        
        %% Only process parameters with DataInterfaceSID (valid mapping info)
        %if CONTAINS(STRING(model_param.Parameter[ParamId]), "DataInterfaceSID")
        
          %% Extract block SID and parameter expression string
          %assign searched_SID = IDNUM(model_param.Parameter[ParamId].DataInterfaceSID)[1]
          %assign FieldStr = model_param.Parameter[ParamId].DataInterfaceGrName
        
          %% Traverse model hierarchy to locate the corresponding block
          %foreach SubID = BLKHR.NumSubsystems

            %assign Subs = BLKHR.Subsystem
            %foreach BID = Subs[SubID].NumBlocks
              %% Identify the correct block via SID
              %if (IDNUM(Subs[SubID].Block[BID].SID)[1] == searched_SID)

                %% Search within block parameters
                %foreach ParamID = Subs[SubID].Block[BID].NumParameters
                  %% Parameter name inside the block 
                  %assign search = Subs[SubID].Block[BID].Parameter[ParamID].Name
                  %% Extract full parameter expression string
                  %if CONTAINS(FieldStr, search)
                    %assign Field = Subs[SubID].Block[BID].Parameter[ParamID].String
                  %endif
                %endforeach
              %endif
            %endforeach
          %endforeach
          
          %%-------------------------------------------------------------------
          %% Handle expression parsing edge cases:
          %%
          %% Case 1: Parameter followed by space → "T "
          %% Case 2: Parameter at end → "T]"
          %%-------------------------------------------------------------------
          %assign sigNameadapted = "%<sigName> "
          %assign sigNameadapted2 = "%<sigName>]"
            
          %% Check if parameter exists in expression
          %if CONTAINS(STRING(Field), sigNameadapted) || CONTAINS(STRING(Field), sigNameadapted2)
            %openfile tmpBuf
            // Original parameter expression (e.g. "[1 T S]")
            char str%<ParamId>[] = "%<Field>";

            // Buffer to store cleaned expression (no brackets/spaces)
            char clean%<ParamId>[100]; // buffer for cleaned string
            int j%<ParamId> = 0;
                    
            //------------------------------------------------------------------
            // Remove formatting characters:
            //  - '[' and ']'
            //  - whitespace
            // Result: compact array-like representation (e.g. "1TS")
            //------------------------------------------------------------------
            for (int i = 0; str%<ParamId>[i] != '\0'; i++) {
              if (str%<ParamId>[i] != '[' && str%<ParamId>[i] != ']' && !isspace(str%<ParamId>[i])) {
                clean%<ParamId>[j%<ParamId>++] = str%<ParamId>[i];
              }
            }
            
            // Null-terminate cleaned string
            clean%<ParamId>[j%<ParamId>] = '\0'; 

            //------------------------------------------------------------------
            // Locate the position of the external parameter inside the
            // expression and assign its value into the correct index
            //------------------------------------------------------------------
            for (int i=0; i < j%<ParamId>; i++){
              if (clean%<ParamId>[i] == '%<sigName>'){
                SIG_MODEL(P, %<model_param.Parameter[ParamId].Identifier>)[i] = pInstanceCapi->P_DISCON_Empty_T[%<GlobParamID>];
              }
            }
            %closefile tmpBuf
            %<LibSetSourceFileSection(fileh, "Defines", tmpBuf)>
          %endif
        %endif
      %endforeach
    %endforeach 

    %openfile tmpBuf
      //----------------------------------------------------------------------
      // Final model initialization step
      // Calls generated Simulink start function
      //----------------------------------------------------------------------
      MdlStart();

	  return NULL;
    }
    %closefile tmpBuf
    %<LibSetSourceFileSection(fileh, "Defines", tmpBuf)>

    %%===========================================================================
    %% DLL API function for model output extraction
    %%===========================================================================
    %openfile tmpBuf
    __declspec(dllexport) const char* __cdecl Model_Outputs(InstanceExtSimEnvCapi *pInstanceCapi, uint32_T IsMajorTimeStep)
    {
        // get the current simulink model output values
        MdlOutputs(0);

	    // Assign outputs foreach output found in thr compiled simulink model. 
        // Use SIG_Model to map the Simulink Signal to the IEC Signal
    %closefile tmpBuf
    %<LibSetSourceFileSection(fileh, "Defines", tmpBuf)>

    %% loop over the number of external outputs
    %foreach OutputID = ExternalOutputs.NumExternalOutputs
        %% get the Output Metadata
        %assign extOut = ExternalOutputs.ExternalOutput[OutputID]
        %assign sigName = extOut.Identifier
        
        %% map the simulink outport to the correct external output
        %openfile tmpBuf  
        pInstanceCapi->ExtY_DISCON_Empty_T[%<OutputID>] = SIG_MODEL(Y, %<sigName>);
        %closefile tmpBuf
        %<LibSetSourceFileSection(fileh, "Defines", tmpBuf)>  

    %endforeach

    %openfile tmpBuf 

	    return NULL;
    }
    %closefile tmpBuf
    %<LibSetSourceFileSection(fileh, "Defines", tmpBuf)>

    %%===========================================================================
    %% DLL API function for model update call
    %%===========================================================================
    %openfile tmpBuf
    __declspec(dllexport) const char* __cdecl Model_Update(InstanceExtSimEnvCapi *pInstanceCapi)
    {
    %closefile tmpBuf
    %<LibSetSourceFileSection(fileh, "Defines", tmpBuf)>

    %% loop over the number of External inputs
    %foreach InputID = ExternalInputs.NumExternalInputs
        %% get the input metadata
        %assign extInp = ExternalInputs.ExternalInput[InputID]
        %assign sigName = extInp.Identifier
    
        %% map the external input value to the correct simulink model Inport
        %openfile tmpBuf  
        SIG_MODEL(U, %<sigName>) = pInstanceCapi->ExtU_DISCON_Empty_T[%<InputID>];
        %closefile tmpBuf
        %<LibSetSourceFileSection(fileh, "Defines", tmpBuf)>  
    %endforeach

    %openfile tmpBuf
        // call the simulink model update function after mapping the 
        // external inputs to the correct inports
        MdlUpdate(0);
	    return NULL;
    }
    %closefile tmpBuf
    %<LibSetSourceFileSection(fileh, "Defines", tmpBuf)>  
  
%endwith  %% %with CompiledModel

%return "Done"

%endfunction   %% %function FcnStructInputOutput() Output

%assign text = FcnStructInputOutput()