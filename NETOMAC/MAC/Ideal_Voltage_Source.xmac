$*******************************************************************************
$ Ideal_Voltage_Source.xmac
$*******************************************************************************
[Version]
ModelName: Ideal_Voltage_Source
ModelDescription: Model for controlling the ideal voltage source of the Thevenin equivalent
ModelVersion: 
ModelAuthor: Becker G., Frauenknecht D.
ModelCompatibility: 0
[Link]
@PSS@ ModTyp = 507
 GNE-V           #NAME    N                                                     ! ID=7
                 #NAME                                                          ! ID=7
[PSS_VARs]
[PSS_Options]
@PSS@ OutFac = 0                       ! Output factor
@PSS@ OutOpt = 0                       ! Integration + power flow
[PSS_Inputs]
[Data]
@DEFAULT@ #Vreal = 1.0, 0.0 , 1E6                  ! Real part of the voltage source [pu]
@DEFAULT@ #Vimag = 0.0, 0.0 , 1E6                  ! Imaginary part of the voltage source [pu]
@DEFAULT@ #Vdip = 0.7, 0.0 , 1E6                   ! Voltage magnitude during voltage dip [pu]
@DEFAULT@ #Tdip1 = 1.0, 0.0 , 1E6                  ! Time at which the voltage dip occurs [s]
@DEFAULT@ #Tdip2 = 1.2, 0.0 , 1E6                  ! Time at which the voltage is restored [s]
@DEFAULT@ #DEBUG = 0, -1 , 2                       ! DEBUG MODE
[Equations]
[Checks]
[Event]
[End]
/5/Block ()
/5/Tdip2=#Tdip2
/5/End Block (Tdip2)
/4/Block ()
/4/Tdip1=#Tdip1
/4/End Block (Tdip1)
/3/Block ()
/3/Vdip=#Vdip
/3/End Block (Vdip)
/2/Block ()
/2/Vimag=#Vimag
/2/End Block (Vimag)
/1/Block ()
/1/Vreal=#Vreal
/1/End Block (Vreal)
/6/Block (Vreal,Vimag,Vdip,Tdip1,Tdip2)
/6/ IF ((TIME.LT.Tdip1).OR.(TIME.GT.Tdip2)) THEN
/6/  Vr = Vreal
/6/  Vi = Vimag
/6/ ELSE
/6/  Vr = Vdip
/6/  Vi = Vimag
/6/ ENDIF
/6/End Block (Vr,Vi)
/7/T=I,N3=OUTPUT,A1=>,D2=Vr,D3=Vi,Z1= ,
//N3='ENDE'
]]></XMAC_7D991BC895B94677AE74C4C5E2BCFDC1></DATA_7D991BC895B94677AE74C4C5E2BCFDC1></XMAC>
