$*******************************************************************************
$ IBR_Control_DLL.xmac
$*******************************************************************************
[Version]
ModelName: IBR_Control_DLL
ModelDescription: Model for Integrating an IBR Control as a DLL
ModelVersion: 
ModelAuthor: Becker G., Frauenknecht D.
ModelCompatibility: 0
[Link]
@PSS@ ModTyp = 511
 EVALUATE        #NAME    N                                                     ! ID=21
[PSS_VARs]
[PSS_Options]
@PSS@ OutFac = 2                       ! Output factor
@PSS@ OutOpt = 0                       ! Integration + power flow
[PSS_Inputs]
@PSS@ Va_pu = RVMAG
@PSS@ Vb_pu = RVMAG
@PSS@ Vc_pu = RVMAG
@PSS@ Ia_MVA = RBRCUM
@PSS@ Ib_MVA = RBRCUM
@PSS@ Ic_MVA = RBRCUM
[Data]
@DEFAULT@ #Va_pu.N = 'Bus2'                        ! Node for Voltage measurement - phase a
@DEFAULT@ #Va_pu.P = 'R'                           ! Phase for Voltage measurement - phase a
@DEFAULT@ #Vb_pu.N = 'Bus2'                        ! Node for Voltage measurement - phase b
@DEFAULT@ #Vb_pu.P = 'S'                           ! Phase for Voltage measurement - phase b
@DEFAULT@ #Vc_pu.N = 'Bus2'                        ! Node for Voltage measurement - phase c
@DEFAULT@ #Vc_pu.P = 'T'                           !  Phase for Voltage measurement - phase c	
@DEFAULT@ #Ia_MVA.N = 'Bus2'                       ! Node for Current measurement - phase a
@DEFAULT@ #Ia_MVA.B = 'Z_IBR'                      ! Branch for Current measurement - phase a
@DEFAULT@ #Ia_MVA.P = 'R'                          ! Phase for Current measurement - phase a
@DEFAULT@ #Ib_MVA.N = 'Bus2'                       ! Node for Current measurement - phase b
@DEFAULT@ #Ib_MVA.B = 'Z_IBR'                      ! Branch for Current measurement - phase b
@DEFAULT@ #Ib_MVA.P = 'S'                          ! Phase for Current measurement - phase b
@DEFAULT@ #Ic_MVA.N = 'Bus2'                       ! Node for Current measurement - phase c
@DEFAULT@ #Ic_MVA.B = 'Z_IBR'                      ! Branch for Current measurement - phase c
@DEFAULT@ #Ic_MVA.P = 'T'                          ! Phase for Current measurement - phase c
@DEFAULT@ #DEBUG = 0, -1 , 2                       ! DEBUG MODE
[Data:$DLL26]
@DEFAULT@ #DT = 0.50000E-01                        ! E: SampleTime in [ms]
@DEFAULT@ #P1 = 50.000, 0.0000 , 0.10000E+07       ! E: Fn Nominal frequency [Hz]
@DEFAULT@ #P2 = 0.11871, 0.0000 , 6.2832           ! E: Iang0_pcc Initial current angle injected at PCC [rad]
@DEFAULT@ #P3 = 703.87                             ! E: Imag0_pcc Initial current magnitude injected at PCC [A]
@DEFAULT@ #P4 = 8000.0, 0.10000E-05 , 0.10000E+07  ! E: Ki_I Integral gain of current controller (continuous) [V/A]
@DEFAULT@ #P5 = 0.20000E-01, 0.10000E-05 , 0.10000E+07     ! E: Ki_PLL Integral gain of phase-locked loop (continous) [Hz/V]
@DEFAULT@ #P6 = 400.00, 0.10000E-05 , 0.10000E+07  ! E: Kp_I Proportional gain of current controller (continuous) [V/A]
@DEFAULT@ #P7 = 0.20000E-03, 0.10000E-05 , 0.10000E+07     ! E: Kp_PLL Proportional gain of phase-locked loop (continous) [Hz/V]
@DEFAULT@ #P8 = 0.15740, 0.10000E-05 , 0.10000E+07 ! E: Lc Converter inductance [H]
@DEFAULT@ #P9 = 0.50000E+09, -0.50000E+09 , 0.50000E+09    ! E: Pref Active power set-point [W]
@DEFAULT@ #P10 = 0.10000E+09, -0.50000E+09 , 0.50000E+09   ! E: Qref Reactive power set-point [VAr]
@DEFAULT@ #P11 = 0.78200, 0.10000E-05 , 0.10000E+07! E: Rc Converter resistance [Ohm]
@DEFAULT@ #P12 = 0.10000, 0.10000E-05 , 0.10000E+07! E: Tf_S Filter time constant of power control (continuous) [s]
@DEFAULT@ #P13 = 0.50000E-04, 0.10000E-05 , 0.10000E-03    ! E: Ts Simulation time step [s]
@DEFAULT@ #P14 = 0.31610, 0.0000 , 6.2832          ! E: Vang0_pcc Initial voltage angle at PCC [rad]
@DEFAULT@ #P15 = 0.41825E+06                       ! E: Vmag0_pcc Initial voltage magnitude at PCC [V]
[Equations]
$ Factor for conversion voltage from pu to V
@ #Vpu2V    = SQRT(2) / SQRT(3) * #Vn * 1e3
$ Factor for conversion voltage from MVA to A
@ #IMVA2A   = SQRT(2) / SQRT(3) / #Vn * 1e3
[Checks]
[Event]
[End]
/6/N1=Ic_MVA,N2=RBRCUM,N3=INPUT,D1=-1.,D4=030000,
/5/N1=Ib_MVA,N2=RBRCUM,N3=INPUT,D1=-1.,D4=030000,
/4/N1=Ia_MVA,N2=RBRCUM,N3=INPUT,D1=-1.,D4=030000,
/3/N1=Vc_pu,N2=RVMAG,N3=INPUT,D1=1.,D4=030000,
/2/N1=Vb_pu,N2=RVMAG,N3=INPUT,D1=1.,D4=030000,
/1/N1=Va_pu,N2=RVMAG,N3=INPUT,D1=1.,D4=030000,
/10/N1=Ia_t,N2=Ia_MVA,N3=PROP,D1=1.,D2=#IMVA2A,D4=1,Z1= ,
/11/N1=Ib_t,N2=Ib_MVA,N3=PROP,D1=1.,D2=#IMVA2A,D4=1,Z1= ,
/12/N1=Ic_t,N2=Ic_MVA,N3=PROP,D1=1.,D2=#IMVA2A,D4=1,Z1= ,
/7/N1=Va,N2=Va_pu,N3=PROP,D1=1.,D2=#Vpu2V,D4=1,Z1= ,
/8/N1=Vb,N2=Vb_pu,N3=PROP,D1=1.,D2=#Vpu2V,D4=1,Z1= ,
/9/N1=Vc,N2=Vc_pu,N3=PROP,D1=1.,D2=#Vpu2V,D4=1,Z1= ,
/13/N1=Ia,N2=Ia_t,N3=DEADTIME,D1=#SIMDT,D2=1,
/14/N1=Ib,N2=Ib_t,N3=DEADTIME,D1=#SIMDT,D2=1,
/15/N1=Ic,N2=Ic_t,N3=DEADTIME,D1=#SIMDT,D2=1,
/18/N1=Eb,N2=Eb_V,N3=PROP,D1=1.,D2=#Vpu2V,D3=1,D4=1,Z1= ,
/19/N1=Ec,N2=Ec_V,N3=PROP,D1=1.,D2=#Vpu2V,D3=1,D4=1,Z1= ,
/26/N1=$DLL0,N3=DLL_IEC,
/26/[Subsystem:$DLL26] (Va, Vb, Vc, Ia, Ib, Ic)
/26/#IBR_Control.mac
/26/[End Subsystem:$DLL26] (Ea_V, Eb_V, Ec_V)
/17/N1=Ea,N2=Ea_V,N3=PROP,D1=1.,D2=#Vpu2V,D3=1,D4=1,Z1= ,
/21/T=I,N3=OUTPUT,D2=Ea,Z1= ,
//N3='ENDE'
]]></XMAC_7D991BC895B94677AE74C4C5E2BCFDC1></DATA_7D991BC895B94677AE74C4C5E2BCFDC1></XMAC>
