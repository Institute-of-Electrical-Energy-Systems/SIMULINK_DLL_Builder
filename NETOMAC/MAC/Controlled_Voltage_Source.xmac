set="0"/></Block><Block ID="1" FieldCode="Rectangle" PenStyle="SOLID" PenWidth="10" ForegroundColor="TRANSPARENT" BackgroundColor="#F0F0F0" HatchStyle="NONE" ShadowStyle="0" Style="0" BackgroundColorAlpha="255" SymbolSize="100" SymbolType="0" SymbolFlip="0" TextInputs="Full" SymbolConnectorAlign="0" X="1250.0" Y="1050.0"><Point ID="Out1" PosX="50.0" PosY="0.0" TextFont="-80,0,0,0,400,0,0,0,0,0,0,0,0,Arial" TextAlign="Left" TextPosition="right/up" TextVisible="Automatic" TextOrientation="0" TextColor="#000000" TextAdjustAngle="NoTextAdjustment" TextAngle="0.0" TextLineOffset="0"/></Block></Model><Objects/></Graphic><Checks><![CDATA[]]></Checks><BOSLInit><![CDATA[]]></BOSLInit><Equations><![CDATA[]]></Equations><XMAC_7D991BC895B94677AE74C4C5E2BCFDC1 Coded="0" ReadOnly="0"><![CDATA[
$*******************************************************************************
$ Controlled_Voltage_Source.xmac
$*******************************************************************************
[Version]
ModelName: Controlled_Voltage_Source
ModelDescription: Model for the interface between the IBR control model and the controlled voltage source
ModelVersion: 
ModelAuthor: Becker G., Frauenknecht D.
ModelCompatibility: 0
[Link]
@PSS@ ModTyp = 550
 MIMO            #NAME    N                                                     ! ID=0
@PSS@ ModTyp = 1
 SOURCE  #NAME.T #NAME.T  N      0     0                                        ! ID=10
                 #NAME    T                                                     ! ID=10
@PSS@ ModTyp = 1
 SOURCE  #NAME.S #NAME.S  N      0     0                                        ! ID=9
                 #NAME    S                                                     ! ID=9
@PSS@ ModTyp = 1
 SOURCE  #NAME.R #NAME    N      0     0                                        ! ID=8
                 #NAME    R                                                     ! ID=8
[PSS_VARs]
[PSS_Options]
[PSS_Inputs]
@PSS@ Ea = INPUT
@PSS@ Eb = INPUT
@PSS@ Ec = INPUT
[Data]
@DEFAULT@ #Model = 'IBR_DLL'                       ! Model Name of the IBR Control Model
@DEFAULT@ #Sig_a = 'Ea'                            ! Signal Name for phase a 
@DEFAULT@ #Sig_b = 'Eb'                            ! Signal Name for phase b 
@DEFAULT@ #Sig_c = 'Ec'                            ! Signal Name for phase c
@DEFAULT@ #Vmag = 1.087535184, 0.0 , 1E3           ! Load-flow voltage magnitude [pu]
@DEFAULT@ #Vang = 25.896609936, 0.0 , 360          ! Load-flow voltage angle [°]
@DEFAULT@ #Tfrz = 50e-6, 0.0 , 1E6                 ! Freezing time at dynamic start [s]
@DEFAULT@ #DEBUG = 0, -1 , 2                       ! DEBUG MODE
[Equations]
[Checks]
[Event]
[End]
/7/Block ()
/7/Tfrz=#Tfrz
/7/End Block (Tfrz)
/6/Block ()
/6/Vang=#Vang
/6/End Block (Vang)
/5/Block ()
/5/Vmag=#Vmag
/5/End Block (Vmag)
/3/N1=Ec,N3=INPUT,D1=1.,D4=#Sig_c,D6=1,
/3/N1=EVALUATE,N3=#Model,
/2/N1=Eb,N3=INPUT,D1=1.,D4=#Sig_b,D6=1,
/2/N1=EVALUATE,N3=#Model,
/1/N1=Ea,N3=INPUT,D1=1.,D4=#Sig_a,D6=1,
/1/N1=EVALUATE,N3=#Model,
/4/Block (Ea,Eb,Ec,Vmag,Vang,Tfrz)
/4/ IF ((BOSL_MODE.EQ.1).OR.(TIME.LT.Tfrz)) THEN                                      
/4/  wt_a    = Vang + FNOM * 360 * TIME
/4/  wt_b    = Vang + FNOM * 360 * TIME - 120
/4/  wt_c    = Vang + FNOM * 360 * TIME - 240
/4/  Va_r    = Vmag * COS(wt_a)                                                        
/4/  Va_i    = Vmag * SIN(wt_a)
/4/  Vb_r    = Vmag * COS(wt_b)                                                        
/4/  Vb_i    = Vmag * SIN(wt_b)
/4/  Vc_r    = Vmag * COS(wt_c)                                                        
/4/  Vc_i    = Vmag * SIN(wt_c)                                                      
/4/ ELSE                                                                            
/4/  Va_r = Ea                                                                                         
/4/  Vb_r = Eb 
/4/  Vc_r = Ec                                                                     
/4/ ENDIF
/4/End Block (Va_r,Va_i,Vb_r,Vb_i,Vc_r,Vc_i)
/10/T= ,N1=#NAME.T,N3=OUTPUT,A1=>,D2=Vc_r,D3=Vc_i,Z1= ,
/9/N1=#NAME.S,N3=OUTPUT,A1=>,D2=Vb_r,D3=Vb_i,
/8/T=I,N1=#NAME.R,N3=OUTPUT,A1=>,D2=Va_r,D3=Va_i,Z1= ,
//N3='ENDE'
]]></XMAC_7D991BC895B94677AE74C4C5E2BCFDC1></DATA_7D991BC895B94677AE74C4C5E2BCFDC1></XMAC>
