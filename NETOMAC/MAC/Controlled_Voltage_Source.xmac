le="4" FaceName="Arial" Escapement="0" Color="#000000"/></PageSetup><Parameters _Version="1"><View Symbolfactor="200" LineCreation="0" LayoutMode="1"/><Grid Visible="false" SnapTo="true" Center="false" Width="5" Height="5" Color="#F0F0F0"/><GuideLines Visible="true" Color="#FF0028"/></Parameters><Model><Block ID="10" Type="SOURCE-V" Disabled="0"><Data ID="ModTyp" Value="1"/><Data ID="Type" Value="SOURCE"/><Data ID="OutName" Value="#NAME.T"/><Data ID="DesH" Value="#NAME.T"/><Data ID="Bnam" Value="N"/><Data ID="Off"/><Data ID="OutName2" Value="{OutName}"/><Data ID="OUTP" Value="OUTPUT"/><Data ID="Inp1" Value="Vc_r"/><Data ID="Inp2" Value="Vc_i"/><Data ID="Sim" Value=" "/><Data ID="Intg" Value=" "/><Data ID="Freq"/><Data ID="Link" Value="&gt;"/><Data ID="OutFac" Value="0"/><Data ID="OutOpt" Value="0"/><Data ID="Branch" Value="#NAME"/><Data ID="BrPh" Value="T"/><Variables/></Block><Block ID="9" Type="SOURCE-V" Disabled="0"><Data ID="ModTyp" Value="1"/><Data ID="Type" Value="SOURCE"/><Data ID="OutName" Value="#NAME.S"/><Data ID="DesH" Value="#NAME.S"/><Data ID="Bnam" Value="N"/><Data ID="Off"/><Data ID="OutName2" Value="{OutName}"/><Data ID="OUTP" Value="OUTPUT"/><Data ID="Inp1" Value="Vb_r"/><Data ID="Inp2" Value="Vb_i"/><Data ID="Link" Value="&gt;"/><Data ID="OutFac" Value="0"/><Data ID="OutOpt" Value="0"/><Data ID="Branch" Value="#NAME"/><Data ID="BrPh" Value="S"/><Variables/></Block><Block ID="8" Type="SOURCE-V" Disabled="0"><Data ID="ModTyp" Value="1"/><Data ID="Type" Value="SOURCE"/><Data ID="OutName" Value="#NAME.R"/><Data ID="DesH" Value="#NAME"/><Data ID="Bnam" Value="N"/><Data ID="Off"/><Data ID="OutName2" Value="{OutName}"/><Data ID="OUTP" Value="OUTPUT"/><Data ID="Inp1" Value="Va_r"/><Data ID="Inp2" Value="Va_i"/><Data ID="Sim" Value=" "/><Data ID="Intg" Value="I"/><Data ID="Freq"/><Data ID="Link" Value="&gt;"/><Data ID="OutFac" Value="0"/><Data ID="OutOpt" Value="0"/><Data ID="Branch" Value="#NAME"/><Data ID="BrPh" Value="R"/><Variables/></Block><Block ID="7" Type="CONST_VAL" Disabled="0"><Data ID="Type" Value="SUM"/><Data ID="Out1" Value="Tfrz"/><Data ID="Fix" Value="#Tfrz"/><Data ID="Mul" Value="1."/><Data ID="InValIn" Value=" "/><Data ID="InVal"/><Variables/></Block><Block ID="6" Type="CONST_VAL" Disabled="0"><Data ID="Type" Value="SUM"/><Data ID="Out1" Value="Vang"/><Data ID="Fix" Value="#Vang"/><Data ID="Mul" Value="1."/><Data ID="InValIn" Value=" "/><Data ID="InVal"/><Variables/></Block><Block ID="5" Type="CONST_VAL" Disabled="0"><Data ID="Type" Value="SUM"/><Data ID="Out1" Value="Vmag"/><Data ID="Fix" Value="#Vmag"/><Data ID="Mul" Value="1."/><Data ID="InValIn" Value=" "/><Data ID="InVal"/><Variables/></Block><Block ID="4" Type="FORTRAN" Disabled="0"><Data ID="Inp1" Value="Ea"/><Data ID="Inp2" Value="Eb"/><Data ID="Inp3" Value="Ec"/><Data ID="Inp4" Value="Vmag"/><Data ID="Inp5" Value="Vang"/><Data ID="Inp6" Value="Tfrz"/><Data ID="Out1" Value="Va_r"/><Data ID="Out2" Value="Va_i"/><Data ID="Out3" Value="Vb_r"/><Data ID="Out4" Value="Vb_i"/><Data ID="Out5" Value="Vc_r"/><Data ID="Out6" Value="Vc_i"/><Variables/><FORTRAN><![CDATA[Block (Ea,Eb,Ec,Vmag,Vang,Tfrz)
 IF ((BOSL_MODE.EQ.1).OR.(TIME.LT.Tfrz)) THEN                                      
  wt_a    = Vang + FNOM * 360 * TIME
  wt_b    = Vang + FNOM * 360 * TIME - 120
  wt_c    = Vang + FNOM * 360 * TIME - 240
                                               
  Va_r    = Vmag * COS(wt_a)                                                        
  Va_i    = Vmag * SIN(wt_a)
  
  Vb_r    = Vmag * COS(wt_b)                                                        
  Vb_i    = Vmag * SIN(wt_b)
  
  Vc_r    = Vmag * COS(wt_c)                                                        
  Vc_i    = Vmag * SIN(wt_c)                                                      
 
 ELSE                                                                            
  
  Va_r = Ea                                                                                         
  Vb_r = Eb 
  Vc_r = Ec                                                                     
 
 ENDIF
End Block (Va_r,Va_i,Vb_r,Vb_i,Vc_r,Vc_i)
]]></FORTRAN></Block><Block ID="3" Type="CONTROLLER" Disabled="0"><Data ID="Type" Value="INPUT"/><Data ID="Out1" Value="Ec"/><Data ID="Mult" Value="1."/><Data ID="Func" Value="1"/><Data ID="Ctrl" Value="EVALUATE"/><Data ID="CtrlNam" Value="#Model"/><Data ID="CtrlOut" Value="#Sig_c"/><Data ID="InValPr"/><Variables/></Block><Block ID="2" Type="CONTROLLER" Disabled="0"><Data ID="Type" Value="INPUT"/><Data ID="Out1" Value="Eb"/><Data ID="Mult" Value="1."/><Data ID="Func" Value="1"/><Data ID="Ctrl" Value="EVALUATE"/><Data ID="CtrlNam" Value="#Model"/><Data ID="CtrlOut" Value="#Sig_b"/><Data ID="InValPr"/><Variables/></Block><Block ID="1" Type="CONTROLLER" Disabled="0"><Data ID="Type" Value="INPUT"/><Data ID="Out1" Value="Ea"/><Data ID="Mult" Value="1."/><Data ID="Func" Value="1"/><Data ID="Ctrl" Value="EVALUATE"/><Data ID="CtrlNam" Value="#Model"/><Data ID="CtrlOut" Value="#Sig_a"/><Data ID="InValPr"/><Variables/></Block></Model><Graphic><Settings><Zoom Level="1985" X="-2106.0" Y="-191.0"/></Settings><Model><Connector ID="12" FieldCode="Polyline" PenStyle="SOLID" PenWidth="10" ForegroundColor="TRANSPARENT" BackgroundColor="TRANSPARENT" Arrow="2" ArrowHeight="50" HatchStyle="NONE" ShadowStyle="0" BackgroundColorAlpha="255" BlockIn="10" BlockOut="4" Input="Inp2" Output="Out6"><Points>4050,1550 4950,1550 4950,2150 5450,2150 </Points></Connector><Connector ID="11" FieldCode="Polyline" PenStyle="SOLID" PenWidth="10" ForegroundColor="TRANSPARENT" BackgroundColor="TRANSPARENT" Arrow="2" ArrowHeight="50" HatchStyle="NONE" ShadowStyle="0" BackgroundColorAlpha="255" BlockIn="10" BlockOut="4" Input="Inp1" Output="Out5"><Points>4050,1450 5050,1450 5050,2050 5450,2050 </Points></Connector><Connector ID="10" FieldCode="Polyline" PenStyle="SOLID" PenWidth="10" ForegroundColor="TRANSPARENT" BackgroundColor="TRANSPARENT" Arrow="2" ArrowHeight="50" HatchStyle="NONE" ShadowStyle="0" BackgroundColorAlpha="255" BlockIn="9" BlockOut="4" Input="Inp2" Output="Out4"><Points>4050,1350 5150,1350 5